    } else {
        tBtn.className = "flex-1 py-2.5 font-bold text-purple-600 bg-white border-b-2 border-purple-500";
        dBtn.className = "flex-1 py-2.5 font-semibold text-slate-500 hover:text-slate-800 bg-slate-50 border-b border-slate-200";
        textArea.classList.remove('hidden'); drawArea.classList.add('hidden');
    }
}

// Chạy khởi tạo sổ vẽ sau khi tải trang 1s
window.addEventListener('load', () => { setTimeout(initSketchpad, 1000); });
    </script>
