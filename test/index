let sketchCanvas, ctx, isDrawing = false, currentTool = 'pen', currentColor = '#1e293b';

function initSketchpad() {
    sketchCanvas = document.getElementById('sketchCanvas');
    if(!sketchCanvas) return;
    ctx = sketchCanvas.getContext('2d');
    
    // Set kích thước chuẩn dựa trên CSS (Width: 480px, Trừ header: Height 520px)
    sketchCanvas.width = 480; 
    sketchCanvas.height = 520;
    ctx.lineCap = 'round'; ctx.lineJoin = 'round';
    
    // Tải hình ảnh đã vẽ trước đó (nếu có)
    const savedImg = localStorage.getItem('kv_sketchpad');
    if(savedImg) {
        let img = new Image();
        img.onload = () => ctx.drawImage(img, 0, 0);
        img.src = savedImg;
    }

    // Sự kiện chuột
    sketchCanvas.addEventListener('mousedown', startDraw);
    sketchCanvas.addEventListener('mousemove', drawLine);
    sketchCanvas.addEventListener('mouseup', stopDraw);
    sketchCanvas.addEventListener('mouseout', stopDraw);
}

function getDrawPos(e) { const rect = sketchCanvas.getBoundingClientRect(); return { x: e.clientX - rect.left, y: e.clientY - rect.top }; }

function startDraw(e) { isDrawing = true; const pos = getDrawPos(e); ctx.beginPath(); ctx.moveTo(pos.x, pos.y); }

function drawLine(e) {
    if (!isDrawing) return;
    const pos = getDrawPos(e);
    if (currentTool === 'eraser') { ctx.globalCompositeOperation = 'destination-out'; ctx.lineWidth = 20; } 
    else { ctx.globalCompositeOperation = 'source-over'; ctx.strokeStyle = currentColor; ctx.lineWidth = 3; }
    ctx.lineTo(pos.x, pos.y); ctx.stroke();
}

function stopDraw() {
    if(isDrawing) { ctx.closePath(); isDrawing = false; localStorage.setItem('kv_sketchpad', sketchCanvas.toDataURL()); }
}

function setDrawMode(tool, color) { currentTool = tool; if(color) currentColor = color; }

function clearCanvas() {
    if(confirm('Bạn có chắc chắn muốn XÓA SẠCH toàn bộ hình vẽ trong sổ?')) {
        ctx.clearRect(0, 0, sketchCanvas.width, sketchCanvas.height);
        localStorage.removeItem('kv_sketchpad');
    }
}

function switchNoteTab(tab) {
