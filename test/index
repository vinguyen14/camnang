        Chart.defaults.font.family = 'Inter'; Chart.defaults.color = '#94a3b8';

        function updateStatusChart() {
            const filter = document.getElementById('filterStatus').value;
            const currentMonth = new Date().getMonth() + 1;
            let data = globalMasterDB;
            if(filter === 'current') data = data.filter(d => parseInt(d.month) === currentMonth);

            let sCounts = { 'Hoàn thành': 0, 'Đang diễn ra': 0, 'Hủy': 0 };
            data.forEach(i => { 
                const s = (i.status || "").trim().toLowerCase();
                if(s.includes('hoàn thành')) sCounts['Hoàn thành']++;
                else if(s.includes('đang')) sCounts['Đang diễn ra']++;
                else if(s.includes('hủy')) sCounts['Hủy']++;
            });

            const ctx = document.getElementById('statusChart'); if(!ctx) return;
            if(statusChartInstance) statusChartInstance.destroy();
            statusChartInstance = new Chart(ctx.getContext('2d'), {
                type: 'doughnut',
                data: { labels:['Hoàn thành', 'Đang diễn ra', 'Hủy'], datasets: [{ data: [sCounts['Hoàn thành'], sCounts['Đang diễn ra'], sCounts['Hủy']], backgroundColor:['#3b82f6', '#0ea5e9', '#ef4444'], borderWidth: 0, hoverOffset: 4 }] },
                options: { responsive: true, maintainAspectRatio: false, cutout: '75%', plugins: { legend: { position: 'bottom', labels: { usePointStyle: true, boxWidth: 6, font: {size: 10, weight: '500'} } } }, layout: { padding: { bottom: 10 } } }
            });
        }

        // BIỂU ĐỒ HIỆU SUẤT THEO NHÓM (STACKED BAR) - Fix chuẩn màu sắc và tên nhãn
        function updatePerfChart() {
            const filter = document.getElementById('filterPerf').value;
            const currentMonth = new Date().getMonth() + 1;
            let data = globalMasterDB;
            if(filter === 'current') data = data.filter(d => parseInt(d.month) === currentMonth);

            // Bảng màu theo yêu cầu
            const colorMap = { 'SPCB': '#60a5fa', 'KV1': '#1e3a8a', 'TAX': '#94a3b8', 'FNB': '#f97316', 'SALON': '#a855f7', 'HOTEL': '#10b981' };
            
            const groups = {};
            data.forEach(i => {
                const name = i.groupName || 'Khác';
                if(!groups[name]) groups[name] = { pass: 0, fail: 0 };
                groups[name].pass += parseInt(i.passedTrainees) || 0;
                groups[name].fail += parseInt(i.failedTrainees) || 0;
            });

            const labels = Object.keys(groups);
            const passData = labels.map(l => groups[l].pass);
            const failData = labels.map(l => groups[l].fail);
            const bgPass = labels.map(l => colorMap[l] || '#10b981'); // Fallback xanh lá

            const ctx = document.getElementById('performanceChart'); if(!ctx) return;
            if(perfChartInstance) perfChartInstance.destroy();
            perfChartInstance = new Chart(ctx.getContext('2d'), {
                type: 'bar',
                data: { 
                    labels: labels, 
                    datasets: [
                        { label: 'Đạt', data: passData, backgroundColor: bgPass, borderRadius: {topLeft: 2, topRight: 2}, barThickness: 24 },
                        { label: 'Trượt', data: failData, backgroundColor:'#ef4444', borderRadius: {bottomLeft: 2, bottomRight: 2}, barThickness: 24 }
                    ] 
                },
                options: { 
                    responsive: true, maintainAspectRatio: false, 
                    plugins: { legend: { display: true, position: 'bottom', labels: { usePointStyle: true, boxWidth: 6, font: {size: 10} } } }, 
                    scales: { 
                        y: { stacked: true, beginAtZero: true, border: {display: false}, grid: {color: '#f1f5f9', borderDash:[4,4]}, ticks: {font: {size: 10}} }, 
                        x: { stacked: true, border: {display: false}, grid: {display: false}, ticks: {font: {size: 9}} } 
                    }, 
                    layout: { padding: { bottom: 10 } } 
                }
            });
        }

