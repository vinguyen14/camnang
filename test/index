    <!-- MAIN JAVASCRIPT & API CALLS -->
    <script>
        // --- 1. CONFIG & STATE ---
        const GOOGLE_API_URL = localStorage.getItem('kv_api_url') || "";
        const AppState = { lang: 'vi', filters: { month: 'all', search: '', status: '' }, sort: { col: '', asc: true }, pagination: { page: 1, limit: 10 } };
        let globalMasterDB =[]; 
        let globalGiftsDB =[];
        let statusChartInstance = null, perfChartInstance = null;

        const courseConfig =[
            { id: 'SPCB', label: 'Retail', title: 'Cơ bản (TS-DS)', desc: 'Quy trình Onboard 3 ngày.', link: 'spcb.html', icon: 'fa-box', color: 'text-blue-600', bg: 'bg-blue-50', border: 'border-blue-200' },
            { id: 'TAX', label: 'Specialist', title: 'Chuyên đề', desc: 'HĐĐT & Kế toán Thuế', link: 'thuehkd.html', icon: 'fa-file-invoice-dollar', color: 'text-emerald-600', bg: 'bg-emerald-50', border: 'border-emerald-200' },
            { id: 'KV1', label: 'Advanced', title: 'Chuyên ngành', desc: 'Xử lý tình huống KV1.', link: 'kv1.html', icon: 'fa-laptop-code', color: 'text-cyan-600', bg: 'bg-cyan-50', border: 'border-cyan-200' },
            { id: 'FNB', label: 'Industry', title: 'Ngành FNB', desc: 'Kịch bản Khóa FNB', link: 'industry.html', icon: 'fa-utensils', color: 'text-orange-500', bg: 'bg-orange-50', border: 'border-orange-200' },
            { id: 'SALON', label: 'Industry', title: 'Ngành Salon', desc: 'Kịch bản Khóa Salon', link: 'industry.html', icon: 'fa-spa', color: 'text-pink-500', bg: 'bg-pink-50', border: 'border-pink-200' },
            { id: 'HOTEL', label: 'Industry', title: 'Ngành Hotel', desc: 'Kịch bản Khóa Hotel', link: 'industry.html', icon: 'fa-hotel', color: 'text-emerald-500', bg: 'bg-emerald-50', border: 'border-emerald-200' }
        ];

        const defaultGifts =[ { name: 'Túi tote', in: 0, out: 0 }, { name: 'Bình nước', in: 0, out: 0 }, { name: 'Áo mưa', in: 0, out: 0 }, { name: 'Cốc', in: 0, out: 0 }, { name: 'Sổ', in: 0, out: 0 } ];

        // --- ĐA NGÔN NGỮ (I18N) ---
        function setLang(lang) {
            AppState.lang = lang;
            if(lang === 'en') {
                document.getElementById('lang-en').className = "cursor-pointer px-2 py-1 rounded bg-white text-blue-600 shadow-sm transition";
                document.getElementById('lang-vi').className = "cursor-pointer px-2 py-1 rounded hover:text-slate-800 transition";
            } else {
                document.getElementById('lang-vi').className = "cursor-pointer px-2 py-1 rounded bg-white text-blue-600 shadow-sm transition";
                document.getElementById('lang-en').className = "cursor-pointer px-2 py-1 rounded hover:text-slate-800 transition";
            }
            document.querySelectorAll('.lang-text').forEach(el => {
                if(el.getAttribute(`data-${lang}`)) el.innerHTML = el.getAttribute(`data-${lang}`);
            });
        }

        // --- FETCH API CHÍNH ---
        async function fetchDatabase() {
            try {
                if(!GOOGLE_API_URL) throw new Error("Local");
                document.getElementById('db-status-indicator').innerHTML = `<i class="fas fa-circle-notch fa-spin text-[10px] text-emerald-500"></i> Syncing...`;
                const response = await fetch(GOOGLE_API_URL);
                const data = await response.json();
                if (data && Array.isArray(data.master)) {
                    globalMasterDB = data.master;
                    localStorage.setItem('kv_master_db', JSON.stringify(data.master));
                    if(data.gifts && data.gifts.length > 0) {
                        globalGiftsDB = data.gifts;
                        localStorage.setItem('kv_gift_db', JSON.stringify(data.gifts));
                    }
                }
                document.getElementById('db-status-indicator').innerHTML = `<i class="fas fa-circle text-[8px] text-emerald-500"></i> Cloud API Active`;
            } catch (err) {
                const localDB = JSON.parse(localStorage.getItem('kv_master_db'));
                globalMasterDB = Array.isArray(localDB) ? localDB : [];
                globalGiftsDB = JSON.parse(localStorage.getItem('kv_gift_db')) || defaultGifts;
                document.getElementById('db-status-indicator').innerHTML = `<i class="fas fa-circle text-[8px] text-amber-500"></i> Local Mode`;
            }
        }

        // --- CHUÔNG THÔNG BÁO VÀ CLICK EVENT ---
        window.addEventListener('click', function(e) {
            const bell = document.getElementById('notiDropdown'); const bellIcon = document.getElementById('bellIcon');
            if (bell && !bell.classList.contains('hidden') && !bell.contains(e.target) && !bellIcon.contains(e.target)) {
                bell.classList.add('hidden');
            }
        });

        function markAllRead(e) {
            e.stopPropagation(); localStorage.setItem('noti_read_time', new Date().getTime());
            const unreadDot = document.getElementById('unreadDot');
            if(unreadDot) unreadDot.classList.add('hidden');
            document.querySelectorAll('.noti-unread-dot').forEach(el => el.classList.add('hidden'));
        }

        function getDynamicCalendar() { return JSON.parse(localStorage.getItem('kv_dynamic_calendar')) || {}; }
        
        function generateSmartAlerts(isDropdown = false) {
            const today = new Date(); const calData = getDynamicCalendar(); let alertsHTML = '';
            const mKey = `${today.getFullYear()}-${today.getMonth() + 1}`;
            const lastReadTime = localStorage.getItem('noti_read_time') || 0; let hasUnread = false;

            if (!calData[mKey]) {
                if(isDropdown) return `<div class="p-6 text-sm text-slate-500 text-center"><i class="fas fa-calendar-times text-3xl text-slate-200 mb-2 block"></i>Chưa cài lịch tháng này</div>`;
                return `<div class="saas-card p-4 flex items-start gap-4 mb-3 border-l-4 border-l-slate-300"><div class="w-10 h-10 rounded-lg bg-slate-50 text-slate-400 flex items-center justify-center font-bold text-lg shrink-0"><i class="fas fa-calendar-times"></i></div><div><h4 class="font-semibold text-slate-800 text-sm">Chưa cài đặt lịch</h4><p class="text-xs font-medium text-slate-500 mt-0.5">Vào Thiết lập để cấu hình</p></div></div>`;
            }

            const checkUpcoming = (dateStr, eventName, type) => {
